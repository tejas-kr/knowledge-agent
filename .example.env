GEMINI_API_KEY=<your gemini api key>
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Local fallback used when Gemini's free-tier quota is exhausted.
# Needs `ollama pull nomic-embed-text-v2-moe` running separately.
# 957 MB, 768-dim, GPU-friendly: ~0.06s/chunk versus ~2.9s/chunk for the
# 8B qwen3-embedding on a 4GB card, which cannot hold it in VRAM.
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
OLLAMA_KEEP_ALIVE=30m

# Seconds to wait for one /api/embed request.
# OLLAMA_TIMEOUT=600

# Comma-separated preference order. Each space owns its own collection, so
# reordering only changes which one is tried first.
# EMBEDDING_FALLBACK_ORDER=gemini-3072,nomic-768

# How long Gemini stays skipped after a quota error, when the error message
# does not say when the daily window resets.
# GEMINI_QUOTA_RESET_HOURS=24

# Where exhausted-provider cooldowns are remembered.
# PROVIDER_HEALTH_FILE=data/provider_health.json

# Answer pipeline (`ask` and POST /ask).
# Which generator answers questions: "ollama" (local, default) or "gemini".
# The local default exists because the Gemini free tier returns transient
# 503 UNAVAILABLE under load and needs no quota.
# GENERATOR_BACKEND=ollama

# Local answer model. Q4 is ~1.1 GB, which leaves room for the KV cache on a
# 4 GB card. The 8B qwen3-embedding lesson applies here too: check VRAM before
# picking anything larger.
# OLLAMA_GENERATION_MODEL=qwen3:1.7b

# Context window for generation. A full RAG prompt is ~3-4k tokens, so Ollama's
# 4096 default can silently truncate the context block. 8192 costs roughly
# 900 MB of KV cache; drop to 4096 to halve that on a tight card.
# OLLAMA_GENERATION_NUM_CTX=8192

# Appended to the question so the model emits [1]-style markers. On by default
# because the small local models do not infer citation markers, and without it
# every citation reports cited=False. SYSTEM_PROMPT is never rewritten.
# RAG_CITE_INSTRUCTION=1

# RAG_TOP_K=5
# Context budget in characters. When the retrieved chunks exceed it, the
# lowest-ranked ones are dropped rather than truncating a chunk mid-sentence.
# RAG_MAX_CONTEXT_CHARS=12000
